@model CustomerSupportAI.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<a class="back-link" asp-controller="Tickets" asp-action="Index">&larr; Quay lại yêu cầu hỗ trợ</a>
<section class="form-page">
    <header class="page-heading compact-heading">
<div>
<span class="eyebrow">BẢO MẬT TÀI KHOẢN</span>
<h1>Đổi mật khẩu</h1>
<p>Mật khẩu mới cần có ít nhất 10 ký tự.</p>
</div>
</header>
    <form asp-action="ChangePassword" method="post" class="surface form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary">
</div>
        <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
<input asp-for="CurrentPassword" autocomplete="current-password" />
<span asp-validation-for="CurrentPassword" class="field-error">
</span>
        <label asp-for="NewPassword">Mật khẩu mới</label>
<input asp-for="NewPassword" autocomplete="new-password" />
<span asp-validation-for="NewPassword" class="field-error">
</span>
        <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
<input asp-for="ConfirmPassword" autocomplete="new-password" />
<span asp-validation-for="ConfirmPassword" class="field-error">
</span>
        <div class="form-footer">
<span>Phiên đăng nhập hiện tại vẫn được duy trì.</span>
<div>
<a class="button button-secondary" asp-controller="Tickets" asp-action="Index">Hủy</a>
<button class="button button-primary" type="submit">Cập nhật mật khẩu</button>
</div>
</div>
    </form>
</section>