@model CustomerSupportAI.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-shell">
    <div class="auth-aside">
        <span class="eyebrow">HỖ TRỢ KHÁCH HÀNG TẬN TÂM</span>
        <h1>Chào mừng bạn trở lại.</h1>
        <p>Tiếp tục trao đổi và theo dõi lịch sử yêu cầu hỗ trợ của bạn.</p>
        <div class="auth-aside-note">
<span class="status-dot">
</span> Truy cập an toàn theo từng vai trò</div>
    </div>
    <div class="auth-panel">
        <span class="eyebrow">ĐĂNG NHẬP</span>
        <h2>Đăng nhập tài khoản</h2>
        <p class="muted">Nhập email và mật khẩu bạn đã đăng ký.</p>
        <form asp-action="Login" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation-summary">
</div>
            <input asp-for="ReturnUrl" type="hidden" />
            <label asp-for="Email">Địa chỉ email</label>
            <input asp-for="Email" autocomplete="email" placeholder="ban@congty.vn" />
            <span asp-validation-for="Email" class="field-error">
</span>
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
            <span asp-validation-for="Password" class="field-error">
</span>
            <label class="check-row">
<input asp-for="RememberMe" /> Duy trì đăng nhập</label>
            <button class="button button-primary button-wide" type="submit">Đăng nhập <span aria-hidden="true">&rarr;</span>
</button>
        </form>
        <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký tài khoản khách hàng</a>
</p>
    </div>
</section>
