@model CustomerSupportAI.Models.SupportUser
@{ ViewData["Title"] = "Tài khoản"; }
<header class="page-heading">
<div>
<span class="eyebrow">KHÔNG GIAN CÁ NHÂN</span>
<h1>Tài khoản của bạn</h1>
<p>Thông tin đăng nhập và bảo mật trong cùng một nơi.</p>
</div>
</header>
<div class="dashboard-grid">
<section class="panel">
<div class="profile-cover">
<span class="profile-avatar">@Model.DisplayName[..1].ToUpperInvariant()</span>
<h2>@Model.DisplayName</h2>
<span class="role-tag">@DisplayText.Role(Model.Role)</span>
</div>
<dl class="detail-list">
<div>
<dt>Email đăng nhập</dt>
<dd>@Model.Email</dd>
</div>
<div>
<dt>Vai trò</dt>
<dd>@DisplayText.Role(Model.Role)</dd>
</div>
</dl>
</section>
<section class="panel">
<span class="eyebrow">BẢO MẬT</span>
<h2>Bảo vệ tài khoản</h2>
<p>Dùng mật khẩu riêng cho tài khoản này. Không chia sẻ mật khẩu hoặc mã xác thực trong cuộc trò chuyện.</p>
<a class="button button-primary" asp-action="ChangePassword">Đổi mật khẩu →</a>
<hr/>
<h3>Cần hỗ trợ tài khoản?</h3>
<p>Tra cứu hướng dẫn đăng nhập và quyền truy cập.</p>
<a class="text-link" asp-controller="Knowledge" asp-action="Index" asp-route-search="tài khoản">Xem hướng dẫn →</a>
</section>
</div>
