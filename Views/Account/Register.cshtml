@model CustomerSupportAI.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
}

<section class="auth-shell">
    <div class="auth-aside">
        <span class="eyebrow">HỖ TRỢ NHANH CHÓNG VÀ THUẬN TIỆN</span>
        <h1>Luôn đồng hành cùng bạn.</h1>
        <p>Tạo tài khoản để gửi yêu cầu, theo dõi phản hồi và lưu lại lịch sử hỗ trợ.</p>
        <div class="auth-aside-note">
<span class="status-dot">
</span> Tài khoản đăng ký mới có quyền Khách hàng</div>
    </div>
    <div class="auth-panel">
        <span class="eyebrow">BẮT ĐẦU</span>
        <h2>Tạo tài khoản khách hàng</h2>
        <p class="muted">Thông tin của bạn chỉ được dùng để quản lý các yêu cầu hỗ trợ.</p>
        <form asp-action="Register" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation-summary">
</div>
            <label asp-for="DisplayName">Họ và tên</label>
            <input asp-for="DisplayName" autocomplete="name" placeholder="Nguyễn Minh Anh" />
            <span asp-validation-for="DisplayName" class="field-error">
</span>
            <label asp-for="Email">Địa chỉ email</label>
            <input asp-for="Email" autocomplete="email" placeholder="ban@congty.vn" />
            <span asp-validation-for="Email" class="field-error">
</span>
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" autocomplete="new-password" placeholder="Ít nhất 10 ký tự" />
            <span asp-validation-for="Password" class="field-error">
</span>
            <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
            <span asp-validation-for="ConfirmPassword" class="field-error">
</span>
            <button class="button button-primary button-wide" type="submit">Tạo tài khoản <span aria-hidden="true">&rarr;</span>
</button>
        </form>
        <p class="auth-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a>
</p>
    </div>
</section>
