@model CustomerSupportAI.ViewModels.AssistantPageViewModel
@{ ViewData["Title"] = "Trợ lý thông minh"; }
<header class="page-heading">
<div>
<span class="eyebrow">GIẢI ĐÁP THEO NGỮ CẢNH</span>
<h1>Trợ lý thông minh <span class="greeting-dot">✳</span>
</h1>
<p>Hỏi, tra cứu và chuyển sang nhân viên khi cần hỗ trợ thêm.</p>
</div>
<span class="mode-badge" id="assistant-mode">@(Model.IsConfigured ? "AI đã cấu hình · chờ phản hồi" : "Tra cứu kho hướng dẫn · chưa kết nối AI")</span>
</header>
<div class="chat-layout">
<section class="assistant-workspace surface" data-endpoint="@Url.Action("Ask", "Assistant")">
<div class="assistant-topline">
<div class="assistant-avatar">✳</div>
<div>
<strong>CustomerSupport Assistant</strong>
<span>Nguồn hướng dẫn rõ ràng · lịch sử riêng tư</span>
</div>
<form asp-action="Clear" method="post">
<button class="button button-small button-secondary" type="submit">Hội thoại mới</button>
</form>
</div>
<div class="assistant-messages" id="assistant-messages" aria-live="polite" aria-label="Nội dung trò chuyện">
<div class="chat-message chat-assistant">
<span class="chat-symbol">✳</span>
<div>
<strong>Xin chào, @User.Identity?.Name</strong>
<p>Tôi có thể hướng dẫn sử dụng hệ thống, tra cứu yêu cầu của bạn và tìm thông tin hỗ trợ. Bạn đang gặp vấn đề gì?</p>
</div>
</div>@foreach(var turn in Model.History){<div class="chat-message chat-user">
<div class="chat-bubble">@turn.Question</div>
</div>
<div class="chat-message chat-assistant">
<div class="chat-bubble">
<span class="reply-mode">@(turn.Mode == "ai" ? "AI" : "Kho hướng dẫn")</span>
<div>@turn.Reply</div>
</div>
</div>}</div>
<form id="assistant-csrf" class="visually-hidden">@Html.AntiForgeryToken()</form>
<div class="prompt-chips">
<button type="button" data-prompt="Làm thế nào để tạo yêu cầu hỗ trợ?">Tạo yêu cầu</button>
<button type="button" data-prompt="Trạng thái yêu cầu của tôi là gì?">Theo dõi trạng thái</button>
<button type="button" data-prompt="Tôi gặp vấn đề đăng nhập tài khoản">Hỗ trợ tài khoản</button>
</div>
<form id="assistant-form" class="assistant-composer">
<label class="visually-hidden" for="assistant-input">Câu hỏi của bạn</label>
<textarea id="assistant-input" rows="2" maxlength="2000" placeholder="Mô tả vấn đề bạn cần hỗ trợ…" required>
</textarea>
<button id="assistant-send" class="button button-primary" type="submit">Gửi ↑</button>
</form>
<div class="assistant-disclaimer">
<span>AI có thể sai. Không gửi mật khẩu, OTP hoặc thông tin thẻ.</span>
<span>Enter để gửi · Shift + Enter xuống dòng</span>
</div>
</section>
<aside class="chat-aside">
<section class="panel">
<span class="eyebrow">NGUỒN THAM KHẢO</span>
<h3>Hướng dẫn liên quan</h3>
<div id="assistant-sources">
<p>Nguồn hướng dẫn phù hợp sẽ xuất hiện sau câu trả lời.</p>
</div>
<a class="text-link" asp-controller="Knowledge" asp-action="Index">Mở kho hướng dẫn →</a>
</section>
<section class="panel handoff-panel">
<span class="stat-icon teal">♧</span>
<h3>Cần người hỗ trợ?</h3>
<p>Chuyển các trao đổi gần đây thành yêu cầu để nhân viên tiếp tục hỗ trợ.</p>@if(User.IsInRole(CustomerSupportAI.Models.UserRoles.Customer)){<form asp-action="Handoff" method="post">
<button class="button button-primary button-wide" type="submit">Chuyển nhân viên →</button>
</form>}else{<a class="button button-secondary" asp-controller="Tickets" asp-action="Index">Mở hàng đợi</a>}</section>
<p class="privacy-note">Khi dùng AI, câu hỏi, hội thoại gần đây và tóm tắt yêu cầu của bạn được gửi đến Gemini để tạo câu trả lời.</p>
</aside>
</div>
@section Scripts{<script src="~/js/assistant.js" asp-append-version="true">
</script>}
