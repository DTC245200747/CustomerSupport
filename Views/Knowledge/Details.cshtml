@model CustomerSupportAI.Models.KnowledgeArticle
@{ ViewData["Title"] = Model.Title; }
<a class="back-link" asp-action="Index">← Kho hướng dẫn</a>
<div class="form-page">
<article class="panel article-body">
<span class="article-category">@Model.Category</span>
<h1>@Model.Title</h1>
<small>Cập nhật @Model.UpdatedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")</small>
<p>@Model.Body</p>@if(User.IsInRole(CustomerSupportAI.Models.UserRoles.Admin)){<a class="button button-secondary" asp-action="Edit" asp-route-id="@Model.Id">Chỉnh sửa hướng dẫn</a>}</article>
<section class="panel help-strip">
<div>
<h3>Vẫn cần hỗ trợ thêm?</h3>
<p>Trợ lý và đội ngũ hỗ trợ luôn có thể giúp bạn tiếp tục.</p>
</div>
<a class="button button-primary" asp-controller="Assistant" asp-action="Index">Hỏi trợ lý →</a>
</section>
</div>
