@model CustomerSupportAI.Models.KnowledgeArticle
@{ ViewData["Title"] = "Biên soạn hướng dẫn"; }
<div class="form-page">
<header class="page-heading">
<div>
<span class="eyebrow">NỘI DUNG HỖ TRỢ</span>
<h1>Biên soạn hướng dẫn</h1>
<p>Nội dung đã lưu sẽ được công khai và dùng làm nguồn trả lời cho trợ lý.</p>
</div>
</header>
<form class="panel form-stack" method="post">
<div asp-validation-summary="All" class="validation-summary">
</div>
<input asp-for="Id" type="hidden"/>
<label asp-for="Title">Tiêu đề</label>
<input asp-for="Title" maxlength="160"/>
<label asp-for="Category">Danh mục</label>
<input asp-for="Category" maxlength="60" list="article-categories"/>
<datalist id="article-categories">@foreach(var c in new[]{"Bắt đầu","Tài khoản","Yêu cầu hỗ trợ","Thanh toán","Sản phẩm","Trợ lý"}){<option value="@c">
</option>}</datalist>
<label asp-for="Body">Nội dung hướng dẫn</label>
<textarea asp-for="Body" rows="12" maxlength="6000">
</textarea>
<div class="action-row">
<button class="button button-primary" type="submit">Lưu hướng dẫn</button>
<a class="button button-secondary" asp-action="Index">Hủy</a>
</div>
</form>
</div>
