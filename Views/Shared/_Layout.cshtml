@{ var signedIn = User.Identity?.IsAuthenticated == true; var controller = ViewContext.RouteData.Values["controller"]?.ToString(); var action = ViewContext.RouteData.Values["action"]?.ToString(); }
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#125b68"/>
<meta name="description" content="CustomerSupport: tra cứu hướng dẫn, hỏi trợ lý và theo dõi yêu cầu hỗ trợ khách hàng."/>
<title>@ViewData["Title"] · CustomerSupport</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<a class="skip-link" href="#main-content">Đi đến nội dung</a>
@if(signedIn){<div class="app-shell">
<aside class="sidebar">
<a class="brand" asp-controller="Dashboard" asp-action="Index">
<span class="brand-mark">cs<span>●</span>
</span>
<span class="brand-copy">
<strong>CustomerSupport</strong>
<small>KẾT NỐI & GIẢI ĐÁP</small>
</span>
</a>
<div class="sidebar-label">KHÔNG GIAN HỖ TRỢ</div>
<nav class="primary-nav" aria-label="Điều hướng chính">@foreach(var item in new[]{("Dashboard","Index","◫","Tổng quan"),("Tickets","Index","▤","Yêu cầu hỗ trợ"),("Assistant","Index","✳","Trợ lý thông minh"),("Knowledge","Index","▧","Kho hướng dẫn"),("Dashboard","Activity","◷","Hoạt động"),("Account","Profile","♙","Tài khoản")}){var active = controller == item.Item1 && (item.Item1 != "Dashboard" || action == item.Item2);<a class="nav-link @(active ? "is-active" : "")" aria-current="@(active ? "page" : null)" asp-controller="@item.Item1" asp-action="@item.Item2">
<span class="nav-icon" aria-hidden="true">@item.Item3</span>@item.Item4</a>}@if(User.IsInRole(CustomerSupportAI.Models.UserRoles.Admin)){<div class="sidebar-label sidebar-label-spaced">QUẢN TRỊ HỆ THỐNG</div>
<a class="nav-link @(controller == "Admin" ? "is-active" : "")" asp-controller="Admin" asp-action="Users">
<span class="nav-icon">♧</span>Tài khoản & quyền</a>
<a class="nav-link @(controller == "Settings" ? "is-active" : "")" asp-controller="Settings" asp-action="Index">
<span class="nav-icon">⚙</span>Cấu hình AI</a>}</nav>
<div class="sidebar-tip">
<span>✦</span>
<strong>Một nơi, mọi giải đáp.</strong>
<p>Bắt đầu với hướng dẫn hoặc trò chuyện với trợ lý.</p>
<a asp-controller="Knowledge" asp-action="Index">Khám phá ngay →</a>
</div>
<div class="sidebar-footer">
<a class="user-chip" asp-controller="Account" asp-action="Profile">
<span class="avatar">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant())</span>
<span class="user-copy">
<strong>@User.Identity?.Name</strong>
<small>@DisplayText.Role(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</small>
</span>
</a>
<form asp-controller="Account" asp-action="Logout" method="post">
<button class="nav-link logout-link" type="submit">
<span class="nav-icon">↗</span>Đăng xuất</button>
</form>
</div>
</aside>
<div class="workspace">
<header class="workspace-topbar">
<span>Không gian làm việc <span class="topbar-divider">/</span> <strong>@ViewData["Title"]</strong>
</span>
<div>
<a asp-controller="Knowledge" asp-action="Index">Trung tâm trợ giúp</a>
<a class="topbar-avatar" asp-controller="Account" asp-action="Profile" aria-label="Tài khoản">@(User.Identity?.Name?.FirstOrDefault())</a>
</div>
</header>
<main class="main-content" id="main-content">@if(TempData["Success"] is string success){<div class="notice notice-success" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="notice notice-error" role="alert">@error</div>}@RenderBody()<footer class="app-footer">
<span>CustomerSupport · Kết nối để giải quyết</span>
<a asp-controller="Knowledge" asp-action="Index">Hướng dẫn sử dụng →</a>
</footer>
</main>
</div>
</div>}
else{<div class="public-shell">
<header class="public-header">
<a class="brand brand-public" asp-controller="Home" asp-action="Index">
<span class="brand-mark">cs<span>●</span>
</span>
<span class="brand-copy">
<strong>CustomerSupport</strong>
<small>KẾT NỐI & GIẢI ĐÁP</small>
</span>
</a>
<nav aria-label="Điều hướng">
<a class="public-help" asp-controller="Knowledge" asp-action="Index">Kho hướng dẫn</a>
<a asp-controller="Account" asp-action="Login">Đăng nhập</a>
<a class="button button-small button-primary" asp-controller="Account" asp-action="Register">Bắt đầu miễn phí →</a>
</nav>
</header>
<main class="public-content" id="main-content">@RenderBody()</main>
<footer class="public-footer">CustomerSupport <span>Rõ ràng trong trao đổi. Chủ động trong hỗ trợ.</span>
</footer>
</div>}
@await RenderSectionAsync("Scripts", required: false)</body>
</html>
