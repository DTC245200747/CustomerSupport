@model CustomerSupportAI.ViewModels.TicketIndexViewModel
@{
    ViewData["Title"] = Model.IsStaff ? "Yêu cầu hỗ trợ" : "Yêu cầu của tôi";
}

<header class="page-heading">
    <div>
<span class="eyebrow">KHÔNG GIAN HỖ TRỢ</span>
<h1>@(Model.IsStaff ? "Danh sách yêu cầu" : "Yêu cầu của tôi")</h1>
<p>@(Model.IsStaff ? "Tiếp nhận, phản hồi và xử lý yêu cầu của khách hàng." : "Theo dõi toàn bộ trao đổi hỗ trợ của bạn tại đây.")</p>
</div>
    @if (!Model.IsStaff)
    {
        <a class="button button-primary" asp-action="Create">
<span aria-hidden="true">＋</span> Tạo yêu cầu</a>
    }
</header>

<section class="metric-row" aria-label="Tổng quan yêu cầu">
    <div class="metric">
<span>Tổng yêu cầu</span>
<strong>@Model.TotalCount</strong>
<small>Trong không gian của bạn</small>
</div>
    <div class="metric">
<span>Đang xử lý</span>
<strong>@Model.OpenCount</strong>
<small>Mới tiếp nhận hoặc đang xử lý</small>
</div>
    <div class="metric">
<span>Đã giải quyết</span>
<strong>@Model.ResolvedCount</strong>
<small>Đã hoàn tất hỗ trợ</small>
</div>
</section>

<section class="data-section">
    <div class="section-heading">
<div>
<h2>@(Model.IsStaff ? "Hàng đợi hỗ trợ" : "Trao đổi của bạn")</h2>
<p>Tìm theo tiêu đề hoặc mã yêu cầu.</p>
</div>
<span class="result-count">@Model.Tickets.Count gần đây</span>
</div>
    <form class="filter-bar" method="get" asp-action="Index">
        <label class="search-field">
<span aria-hidden="true">⌕</span>
<input name="search" value="@Model.Search" placeholder="Tìm yêu cầu hỗ trợ" aria-label="Tìm yêu cầu hỗ trợ" />
</label>
        <select name="status" aria-label="Lọc theo trạng thái">
            <option value="">Tất cả trạng thái</option>
            @foreach (var status in new[] { "Open", "In progress", "Resolved", "Closed" })
            {
                <option value="@status" selected="@(Model.Status == status ? "selected" : null)">@DisplayText.TicketStatus(status)</option>
            }
        </select>
        <button class="button button-secondary" type="submit">Lọc</button>
    </form>
    @if (Model.Tickets.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-mark">—</span>
<h3>Chưa có yêu cầu phù hợp</h3>
            <p>@(Model.Search.Length > 0 || Model.Status.Length > 0 ? "Hãy thử thay đổi nội dung tìm kiếm hoặc bộ lọc." : Model.IsStaff ? "Yêu cầu mới của khách hàng sẽ xuất hiện tại đây." : "Khi cần hỗ trợ, hãy gửi yêu cầu để đội ngũ chăm sóc khách hàng phản hồi.")</p>
            @if (!Model.IsStaff && Model.TotalCount == 0)
            {
                <a class="button button-primary" asp-action="Create">Gửi yêu cầu đầu tiên</a>
            }
        </div>
    }
    else
    {
        <div class="table-scroll">
<table class="data-table">
<thead>
<tr>
<th>Yêu cầu</th>
<th>Khách hàng</th>
<th>Danh mục</th>
<th>Trạng thái</th>
<th>Cập nhật gần nhất</th>
<th>
</th>
</tr>
</thead>
<tbody>
        @foreach (var ticket in Model.Tickets)
        {
            var statusClass = ticket.Status.ToLowerInvariant().Replace(" ", "-");
            <tr>
<td>
<a class="ticket-link" asp-action="Details" asp-route-id="@ticket.Id">@ticket.TicketNumber<span>@ticket.Subject</span>
</a>
</td>
<td>@(Model.IsStaff ? ticket.Customer.DisplayName : "Bạn")</td>
<td>
<span class="category-text">@DisplayText.TicketCategory(ticket.Category)</span>
</td>
<td>
<span class="status status-@statusClass">
<i>
</i>@DisplayText.TicketStatus(ticket.Status)</span>
</td>
<td>@ticket.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
<td>
<a class="text-link" asp-action="Details" asp-route-id="@ticket.Id" aria-label="Mở yêu cầu @ticket.TicketNumber">Mở <span aria-hidden="true">&rarr;</span>
</a>
</td>
</tr>
        }
        </tbody>
</table>
</div>
        @if (Model.TotalCount > Model.Tickets.Count)
        {
            <p class="table-note">Đang hiển thị @Model.Tickets.Count trong tổng số @Model.TotalCount yêu cầu gần nhất.</p>
        }
    }
</section>